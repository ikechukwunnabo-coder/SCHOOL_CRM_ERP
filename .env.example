# School CRM & ERP - Environment Variables (example)
# Copy to .env and fill values. NEVER commit real secrets.

# General
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Database (PostgreSQL)
POSTGRES_DB=school_erp
POSTGRES_USER=school_erp
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://school_erp:change-me@localhost:5432/school_erp

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_ACKS_LATE=True
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_BEAT_SCHEDULE_FILENAME=celerybeat-schedule

# CORS / Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Security / Auth
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_SSL_REDIRECT=False

# File storage (dev: local; prod: s3)
STORAGE_BACKEND=local
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=

# Email (dev defaults; configure provider per D-013)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# SMS / Integrations (placeholders per D-012/D-013)
PAYMENT_PROVIDER=mock
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=

# Institution defaults (configurable per D-002)
DEFAULT_TIME_ZONE=Africa/Lagos
DEFAULT_LANGUAGE_CODE=en-ng
DEFAULT_CURRENCY=NGN
DEFAULT_DATE_FORMAT=DD/MM/YYYY
